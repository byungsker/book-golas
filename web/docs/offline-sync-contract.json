  ],
  "stateRows": [
    {
      "state": "loading",
      "native": "Load the current user-scoped surface before accepting an action.",
      "web": "BLab loading or skeleton state preserves fields and prevents duplicate submission.",
      "action": "wait-for-load",
      "retryable": false,
      "queue": false
    },
    {
      "state": "empty",
      "native": "Show the next useful reading action when no records are present.",
      "web": "Localized empty state keeps the route and add or retry action available.",
      "action": "open-supported-route",
      "retryable": false,
      "queue": false
    },
    {
      "state": "error",
      "native": "Show a recoverable provider or persistence error.",
      "web": "Localized error state preserves safe navigation and exposes retry.",
      "action": "retry-online",
      "retryable": true,
      "queue": false
    },
    {
      "state": "unauthorized",
      "native": "Return to sign-in without exposing another user's records.",
      "web": "Locale-preserving sign-in redirect uses a validated next path.",
      "action": "sign-in",
      "retryable": false,
      "queue": false
    },
    {
      "state": "consent",
      "native": "Ask for explicit provider, AI or device permission where required.",
      "web": "Consent or browser permission remains a separate state from offline.",
      "action": "grant-consent-or-cancel",
      "retryable": true,
      "queue": false
    },
    {
      "state": "quota",
      "native": "Explain the gated action without starting an unapproved purchase flow.",
      "web": "Quota feedback disables only the gated action and keeps billing disabled.",
      "action": "retry-after-quota-window",
      "retryable": true,
      "queue": false
    },
    {
      "state": "offline",
      "native": "Native local cache and draft behavior is partial and surface-specific.",
      "web": "Online-only mutations become read-only with no hidden queue; proven review text remains local.",
      "action": "reconnect",
      "retryable": true,
      "queue": false
    },
    {
      "state": "reconnect",
      "native": "Resume network-backed work after connectivity returns.",
      "web": "The shared shell emits bookgolas:online-reconnected and shows an observable retry state.",
      "action": "retry-interrupted-action",
      "retryable": true,
      "queue": false
    },
    {
      "state": "conflict",
      "native": "Resolve or recover a server version conflict explicitly.",
      "web": "Keep the failed online action visible and require an explicit refresh or retry.",
      "action": "refresh-and-retry",
      "retryable": true,
      "queue": false
    },
    {
      "state": "duplicate",
      "native": "Idempotency is required before an offline replay can be claimed.",
      "web": "No offline replay is attempted, so duplicate writes are rejected before queuing.",
      "action": "retry-online",
      "retryable": true,
      "queue": false
    },
    {
      "state": "unsupported-mutation",
      "native": "Images, AI, push and active timer remain online-only.",
      "web": "Unsupported offline mutations show the online-only boundary and do not enter a queue.",
      "action": "reconnect-before-action",
      "retryable": true,
      "queue": false
    }
  ],
