{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "SUPABASE_SERVICE_ROLE_KEY",
    "AI_MONITOR_PREVIEW_DEMO"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
