{
  "name": "bookgolas",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:client": "turbo run dev --filter=@bookgolas/client",
    "dev:admin": "turbo run dev --filter=@bookgolas/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:client": "pnpm --filter @bookgolas/client test"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
